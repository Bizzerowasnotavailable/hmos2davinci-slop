{
  "name": "GPU: Mesa freedreno (Adreno 618) for OpenGL ES",
  "default": true,
  "requires": [
    "10-display"
  ],
  "description": "Mesa 26 (freedreno on kgsl) as the system EGL/GLES driver instead of Huawei's Maleoon driver, Adreno firmware from the sweet ROM, Vulkan ICD removed so render_service stays on GLES.",
  "vendor_files": [
    {
      "src": "files/lib64/chipsetsdk/libEGL_impl.so",
      "dst": "lib64/chipsetsdk/libEGL_impl.so",
      "mode": "0644",
      "replace_symlink": true
    },
    {
      "src": "files/lib64/chipsetsdk/libGLESv1_impl.so",
      "dst": "lib64/chipsetsdk/libGLESv1_impl.so",
      "mode": "0644",
      "replace_symlink": true
    },
    {
      "src": "files/lib64/chipsetsdk/libGLESv2_impl.so",
      "dst": "lib64/chipsetsdk/libGLESv2_impl.so",
      "mode": "0644",
      "replace_symlink": true
    },
    {
      "src": "files/lib64/chipsetsdk/libGLESv3_impl.so",
      "dst": "lib64/chipsetsdk/libGLESv3_impl.so",
      "mode": "0644",
      "replace_symlink": true
    },
    {
      "src": "files/lib64/chipsetsdk/libgallium-26.1.0-devel.so",
      "dst": "lib64/chipsetsdk/libgallium-26.1.0-devel.so",
      "mode": "0644"
    }
  ],
  "vendor_remove": [
    "etc/vulkan/icd.d/vulkan_driver_v200.json"
  ],
  "sweet_blobs": [
    {
      "from": "firmware/a630_sqe.fw",
      "to": "firmware/a630_sqe.fw"
    },
    {
      "from": "firmware/a618_gmu.bin",
      "to": "firmware/a618_gmu.bin"
    },
    {
      "from": "firmware/a615_zap.mdt",
      "to": "firmware/a615_zap.mdt"
    },
    {
      "from": "firmware/a615_zap.b00",
      "to": "firmware/a615_zap.b00"
    },
    {
      "from": "firmware/a615_zap.b01",
      "to": "firmware/a615_zap.b01"
    },
    {
      "from": "firmware/a615_zap.b02",
      "to": "firmware/a615_zap.b02"
    },
    {
      "from": "firmware/a615_zap.elf",
      "to": "firmware/a615_zap.elf"
    }
  ],
  "ueventd": [
    "# hmos2sweet: Adreno 618 (kgsl) + ion for Mesa freedreno",
    "/dev/kgsl-3d0 0666 0 1003",
    "/dev/ion 0666 0 1003"
  ],
  "init": {
    "jobs": [
      {
        "name": "post-fs-data",
        "cmds": [
          "setparam persist.sys.graphic.GpuApitype 0",
          "chmod 0666 /dev/kgsl-3d0",
          "chmod 0666 /dev/ion"
        ]
      },
      {
        "name": "param:persist.sys.graphic.GpuApitype=1",
        "condition": "persist.sys.graphic.GpuApitype=1",
        "cmds": [
          "setparam persist.sys.graphic.GpuApitype 0"
        ]
      },
      {
        "name": "param:persist.sys.graphic.GpuApitype=2",
        "condition": "persist.sys.graphic.GpuApitype=2",
        "cmds": [
          "setparam persist.sys.graphic.GpuApitype 0"
        ]
      }
    ]
  }
}