{
  "name": "Smoother UI (GPU at full speed)",
  "default": true,
  "requires": [
    "11-gpu-mesa"
  ],
  "description": "Keeps the Adreno 618 at its maximum clock after boot (performance governor) and makes schedutil react faster. render_service composes the whole screen on the GPU, so this removes most of the stutter at the cost of some battery.",
  "init": {
    "jobs": [
      {
        "name": "param:bootevent.boot.completed=true",
        "condition": "bootevent.boot.completed=true",
        "cmds": [
          "write /sys/class/kgsl/kgsl-3d0/devfreq/governor performance",
          "write /sys/class/kgsl/kgsl-3d0/idle_timer 1000",
          "write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/up_rate_limit_us 500",
          "write /sys/devices/system/cpu/cpu6/cpufreq/schedutil/up_rate_limit_us 500",
          "write /sys/devices/system/cpu/cpu0/cpufreq/schedutil/down_rate_limit_us 20000",
          "write /sys/devices/system/cpu/cpu6/cpufreq/schedutil/down_rate_limit_us 20000",
          "write /sys/module/lpm_levels/parameters/sleep_disabled N"
        ]
      }
    ]
  }
}
