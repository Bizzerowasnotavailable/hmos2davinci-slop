From 3187a505a441afe27c4c25448c401c70eeb42f94 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 19 Oct 2026 07:05:39 +0200
Subject: [PATCH 07/12] ohos: report FS_VERITY_FL on regular files
 (OHOS_FSVERITY_STUB)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013BnD2kisuqqyfphx6EWB2p
---
 fs/ioctl.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/fs/ioctl.c b/fs/ioctl.c
index 04e947d4c..0f2112216 100644
--- a/fs/ioctl.c
+++ b/fs/ioctl.c
@@ -640,6 +640,17 @@ int do_vfs_ioctl(struct file *filp, unsigned int fd, unsigned int cmd,
 	if (_IOC_TYPE(cmd) == 'f' && _IOC_DIR(cmd) == _IOC_WRITE &&
 	    (_IOC_NR(cmd) == 133 || _IOC_NR(cmd) == 200) && S_ISREG(inode->i_mode))
 		return 0;
+	/* ...and report every regular file as verity-enabled (FS_VERITY_FL),
+	 * which is what installd checks after enabling */
+	if (cmd == FS_IOC_GETFLAGS && S_ISREG(inode->i_mode)) {
+		unsigned int flags;
+
+		error = vfs_ioctl(filp, cmd, arg);
+		if (!error && !get_user(flags, (unsigned int __user *)argp))
+			error = put_user(flags | 0x00100000 /* FS_VERITY_FL */,
+					 (unsigned int __user *)argp);
+		return error;
+	}
 #endif
 
 	switch (cmd) {
