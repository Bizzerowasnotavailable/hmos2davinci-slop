From 793afe77522d2d8564821f6fbec49a105293f1d6 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 19 Oct 2026 14:59:01 +0200
Subject: [PATCH 09/12] binder: report the sender pid of one-way transactions
 (OpenHarmony)

render_service and other OpenHarmony services check the calling pid of
async (one-way) calls; Linux binder reports 0 for them, so e.g. form
render service transactions were refused.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013BnD2kisuqqyfphx6EWB2p
---
 drivers/android/binder.c | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/drivers/android/binder.c b/drivers/android/binder.c
index 009e7848d..8b8e25190 100644
--- a/drivers/android/binder.c
+++ b/drivers/android/binder.c
@@ -666,6 +666,10 @@ struct binder_transaction {
 	u64 sender_tokenid;
 	u64 first_tokenid;
 #endif
+	/* OpenHarmony: one-way transactions still report the sender pid
+	 * (render_service, samgr... check it for async calls too) */
+	pid_t async_from_pid;
+	pid_t async_from_tid;
 };
 
 /**
@@ -3423,6 +3427,10 @@ static void binder_transaction(struct binder_proc *proc,
 		t->from = thread;
 	else
 		t->from = NULL;
+	if (!reply && (tr->flags & TF_ONE_WAY)) {
+		t->async_from_pid = current->tgid;
+		t->async_from_tid = current->pid;
+	}
 	t->sender_euid = task_euid(proc->tsk);
 #ifdef CONFIG_ACCESS_TOKENID
 	t->sender_tokenid = current->token;
@@ -4709,10 +4717,10 @@ static int binder_thread_read(struct binder_proc *proc,
 			binder_inner_proc_unlock(thread->proc);
 #endif
 		} else {
-			trd->sender_pid = 0;
+			trd->sender_pid = t->async_from_pid;
 #ifdef CONFIG_BINDER_SENDER_INFO
 			binder_inner_proc_lock(thread->proc);
-			thread->sender_pid_nr = 0;
+			thread->sender_pid_nr = t->async_from_pid;
 			binder_inner_proc_unlock(thread->proc);
 #endif
 		}
-- 
