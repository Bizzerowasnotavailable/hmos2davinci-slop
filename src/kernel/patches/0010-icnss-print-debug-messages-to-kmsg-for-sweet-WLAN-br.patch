From: Claude <noreply@anthropic.com>
Date: Mon, 19 Oct 2026 19:15:13 +0200
Subject: [PATCH 10/12] icnss: print debug messages to kmsg for sweet WLAN
 bring-up

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013BnD2kisuqqyfphx6EWB2p
---
 drivers/soc/qcom/icnss_private.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/soc/qcom/icnss_private.h b/drivers/soc/qcom/icnss_private.h
index 2aacf3bb1..59e215595 100644
--- a/drivers/soc/qcom/icnss_private.h
+++ b/drivers/soc/qcom/icnss_private.h
@@ -70,7 +70,7 @@
 	} while (0)
 #else
 #define icnss_pr_dbg(_fmt, ...) do {					\
-	no_printk("%s" pr_fmt(_fmt), KERN_DEBUG, ##__VA_ARGS__);	\
+	printk("%s" pr_fmt(_fmt), KERN_INFO, ##__VA_ARGS__);	/* sweet bring-up */ \
 	icnss_ipc_log_string("%s" pr_fmt(_fmt), "",			\
 		     ##__VA_ARGS__);					\
 	} while (0)
