From 12239d99914bb7f50fefa7fb854a56a1ae7b506d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 20 Oct 2026 06:37:32 +0200
Subject: [PATCH 11/12] icnss: download the WLAN board data file from the
 kernel

Android's cnss-daemon sends bdwlan.<board id> to the WCN3990 firmware over
QMI; HarmonyOS has no such daemon and the firmware never reports FW_READY.
Send it right after the capability exchange, like upstream ath10k does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013BnD2kisuqqyfphx6EWB2p
---
 drivers/soc/qcom/icnss.c     |   3 +
 drivers/soc/qcom/icnss_qmi.c | 137 +++++++++++++++++++++++++++++++++++
 drivers/soc/qcom/icnss_qmi.h |   5 ++
 3 files changed, 145 insertions(+)

diff --git a/drivers/soc/qcom/icnss.c b/drivers/soc/qcom/icnss.c
index 236f5dd29..6d7256a01 100644
--- a/drivers/soc/qcom/icnss.c
+++ b/drivers/soc/qcom/icnss.c
@@ -1042,6 +1042,9 @@ static int icnss_driver_event_server_arrive(void *data)
 	wlfw_dynamic_feature_mask_send_sync_msg(penv,
 						dynamic_feature_mask);
 
+	/* sweet/HarmonyOS: no cnss-daemon to send the board data file */
+	icnss_sweet_download_bdf(penv);
+
 	if (!penv->fw_error_fatal_irq)
 		register_fw_error_notifications(&penv->pdev->dev);
 
diff --git a/drivers/soc/qcom/icnss_qmi.c b/drivers/soc/qcom/icnss_qmi.c
index 1332b6157..bb7e02ea2 100644
--- a/drivers/soc/qcom/icnss_qmi.c
+++ b/drivers/soc/qcom/icnss_qmi.c
@@ -23,6 +23,8 @@
 #include <linux/seq_file.h>
 #include <linux/slab.h>
 #include <linux/delay.h>
+#include <linux/firmware.h>
+#include <linux/platform_device.h>
 #include <linux/ipc_logging.h>
 #include <linux/thread_info.h>
 #include <linux/soc/qcom/qmi.h>
@@ -434,6 +436,141 @@ int wlfw_cap_send_sync_msg(struct icnss_priv *priv)
 	return ret;
 }
 
+/*
+ * HarmonyOS on sweet: there is no cnss-daemon, which on Android downloads the
+ * board data file (BDF) to the WLAN firmware. Without it the firmware never
+ * reports FW_READY. Download it here, like ath10k does upstream:
+ * bdwlan.b<id> / bdwlan.<id> / bdwlan.bin from the firmware partition.
+ */
+static int wlfw_send_bdf(struct icnss_priv *priv, const u8 *data, size_t size)
+{
+	struct wlfw_bdf_download_req_msg_v01 *req;
+	struct wlfw_bdf_download_resp_msg_v01 *resp;
+	struct qmi_txn txn;
+	size_t left = size;
+	u32 seg = 0;
+	int ret = 0;
+
+	req = kzalloc(sizeof(*req), GFP_KERNEL);
+	resp = kzalloc(sizeof(*resp), GFP_KERNEL);
+	if (!req || !resp) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	while (left) {
+		size_t n = min_t(size_t, left, QMI_WLFW_MAX_DATA_SIZE_V01);
+
+		memset(req, 0, sizeof(*req));
+		memset(resp, 0, sizeof(*resp));
+		req->valid = 1;
+		req->file_id_valid = 1;
+		req->file_id = 0;
+		req->total_size_valid = 1;
+		req->total_size = size;
+		req->seg_id_valid = 1;
+		req->seg_id = seg++;
+		req->data_valid = 1;
+		req->data_len = n;
+		memcpy(req->data, data + (size - left), n);
+		req->end_valid = 1;
+		req->end = (left == n);
+
+		ret = qmi_txn_init(&priv->qmi, &txn, wlfw_bdf_download_resp_msg_v01_ei, resp);
+		if (ret < 0)
+			goto out;
+		ret = qmi_send_request(&priv->qmi, NULL, &txn, QMI_WLFW_BDF_DOWNLOAD_REQ_V01,
+				       WLFW_BDF_DOWNLOAD_REQ_MSG_V01_MAX_MSG_LEN,
+				       wlfw_bdf_download_req_msg_v01_ei, req);
+		if (ret < 0) {
+			qmi_txn_cancel(&txn);
+			goto out;
+		}
+		ret = qmi_txn_wait(&txn, WLFW_TIMEOUT);
+		if (ret < 0)
+			goto out;
+		if (resp->resp.result != QMI_RESULT_SUCCESS_V01) {
+			icnss_pr_err("sweet: BDF segment %u rejected, result %d error %d\n",
+				     seg - 1, resp->resp.result, resp->resp.error);
+			ret = -EINVAL;
+			goto out;
+		}
+		left -= n;
+	}
+out:
+	kfree(req);
+	kfree(resp);
+	return ret;
+}
+
+static int wlfw_send_cal_report(struct icnss_priv *priv)
+{
+	struct wlfw_cal_report_req_msg_v01 *req;
+	struct wlfw_cal_report_resp_msg_v01 *resp;
+	struct qmi_txn txn;
+	int ret;
+
+	req = kzalloc(sizeof(*req), GFP_KERNEL);
+	resp = kzalloc(sizeof(*resp), GFP_KERNEL);
+	if (!req || !resp) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	ret = qmi_txn_init(&priv->qmi, &txn, wlfw_cal_report_resp_msg_v01_ei, resp);
+	if (ret < 0)
+		goto out;
+	ret = qmi_send_request(&priv->qmi, NULL, &txn, QMI_WLFW_CAL_REPORT_REQ_V01,
+			       WLFW_CAL_REPORT_REQ_MSG_V01_MAX_MSG_LEN,
+			       wlfw_cal_report_req_msg_v01_ei, req);
+	if (ret < 0) {
+		qmi_txn_cancel(&txn);
+		goto out;
+	}
+	ret = qmi_txn_wait(&txn, WLFW_TIMEOUT);
+	if (ret >= 0 && resp->resp.result != QMI_RESULT_SUCCESS_V01)
+		ret = -EINVAL;
+out:
+	kfree(req);
+	kfree(resp);
+	return ret;
+}
+
+int icnss_sweet_download_bdf(struct icnss_priv *priv)
+{
+	const struct firmware *fw = NULL;
+	char name[3][32];
+	int i, ret = -ENOENT;
+	u32 id = priv->board_id;
+
+	if (id == 0xFF) {
+		snprintf(name[0], sizeof(name[0]), "bdwlan.bin");
+		name[1][0] = name[2][0] = 0;
+	} else {
+		snprintf(name[0], sizeof(name[0]), id < 0x100 ? "bdwlan.b%02x" : "bdwlan.%03x", id);
+		snprintf(name[1], sizeof(name[1]), "bdwlan.b%02x", id & 0xff);
+		snprintf(name[2], sizeof(name[2]), "bdwlan.bin");
+	}
+	for (i = 0; i < 3 && ret; i++) {
+		if (!name[i][0])
+			continue;
+		ret = request_firmware_direct(&fw, name[i], &priv->pdev->dev);
+		if (!ret)
+			icnss_pr_info("sweet: board id 0x%x, BDF %s (%zu bytes)\n", id, name[i], fw->size);
+	}
+	if (ret) {
+		icnss_pr_err("sweet: no BDF for board id 0x%x\n", id);
+		return ret;
+	}
+	ret = wlfw_send_bdf(priv, fw->data, fw->size);
+	release_firmware(fw);
+	icnss_pr_info("sweet: BDF download %s (%d)\n", ret ? "failed" : "done", ret);
+	if (!ret) {
+		int r = wlfw_send_cal_report(priv);
+
+		icnss_pr_info("sweet: cal report %d\n", r);
+	}
+	return ret;
+}
+
 int wlfw_wlan_mode_send_sync_msg(struct icnss_priv *priv,
 		enum wlfw_driver_mode_enum_v01 mode)
 {
diff --git a/drivers/soc/qcom/icnss_qmi.h b/drivers/soc/qcom/icnss_qmi.h
index 983f43071..588d540a4 100644
--- a/drivers/soc/qcom/icnss_qmi.h
+++ b/drivers/soc/qcom/icnss_qmi.h
@@ -32,6 +32,10 @@ static inline int wlfw_msa_ready_send_sync_msg(struct icnss_priv *priv)
 {
 	return 0;
 }
+static inline int icnss_sweet_download_bdf(struct icnss_priv *priv)
+{
