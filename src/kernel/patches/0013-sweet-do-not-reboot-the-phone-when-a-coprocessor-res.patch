From d0a3f530a761941665bc50fe995a8a1e527d4d91 Mon Sep 17 00:00:00 2001
From: hmos2sweet <hmos2sweet@localhost>
Date: Tue, 20 Oct 2026 07:04:10 +0200
Subject: [PATCH] sweet: do not reboot the phone when a coprocessor restart is
 slow

CONFIG_PANIC_ON_SSR_NOTIF_TIMEOUT panics after 20 s when a subsystem
notifier blocks during a restart of the ADSP or the modem. On a port where
userspace (sensors, WLAN, audio) is still being brought up these restarts
happen and the panic reboots the phone. Turn it into a warning, and with
hmos.noreboot=1 also log a crash during SSR instead of panicking.
---
 arch/arm64/configs/vendor/ohos.config |  3 +++
 drivers/soc/qcom/subsystem_restart.c  | 10 ++++++++++
 2 files changed, 13 insertions(+)

diff --git a/arch/arm64/configs/vendor/ohos.config b/arch/arm64/configs/vendor/ohos.config
index d7d44d4a7..94b4997dc 100644
--- a/arch/arm64/configs/vendor/ohos.config
+++ b/arch/arm64/configs/vendor/ohos.config
@@ -29,3 +29,6 @@ CONFIG_OHOS_FS_EMU=y
 CONFIG_TMPFS=y
 # installd code signing on a kernel without fs-verity
 CONFIG_OHOS_FSVERITY_STUB=y
+# a coprocessor (ADSP/modem) that is slow to restart must not take the whole
+# phone down: subsystem notifier timeouts only warn
+# CONFIG_PANIC_ON_SSR_NOTIF_TIMEOUT is not set
diff --git a/drivers/soc/qcom/subsystem_restart.c b/drivers/soc/qcom/subsystem_restart.c
index ad509458d..96fee8af1 100644
--- a/drivers/soc/qcom/subsystem_restart.c
+++ b/drivers/soc/qcom/subsystem_restart.c
@@ -1212,6 +1212,16 @@ static void __subsystem_restart_dev(struct subsys_device *dev)
 			__pm_stay_awake(&dev->ssr_wlock);
 			queue_work(ssr_wq, &dev->work);
 		} else {
+#ifdef CONFIG_OHOS_BRINGUP_NOREBOOT
+			extern bool hmos_noreboot;
+
+			if (hmos_noreboot) {
+				pr_err("subsys-restart: %s crashed during SSR (hmos.noreboot: not panicking)\n",
+					name);
+				spin_unlock_irqrestore(&track->s_lock, flags);
+				return;
+			}
+#endif
 			panic("Subsystem %s crashed during SSR!", name);
 		}
 	} else
-- 
