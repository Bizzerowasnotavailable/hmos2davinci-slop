From 35cca0ebef184bfdbc3fbb9a39014c3c4366f069 Mon Sep 17 00:00:00 2001
From: hmos2sweet <hmos2sweet@localhost>
Date: Fri, 23 Oct 2026 22:03:08 +0200
Subject: [PATCH] icnss: BDF download reported success as failure

qmi_txn_wait() returns the decoded response length on success, so the
segment loop ended with a positive value, the download was logged as
failed and the calibration report (which makes the WLAN firmware send
FW_READY) was never sent.
---
 drivers/soc/qcom/icnss_qmi.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/drivers/soc/qcom/icnss_qmi.c b/drivers/soc/qcom/icnss_qmi.c
index bb7e02ea2..54789c6c9 100644
--- a/drivers/soc/qcom/icnss_qmi.c
+++ b/drivers/soc/qcom/icnss_qmi.c
@@ -495,6 +495,8 @@ static int wlfw_send_bdf(struct icnss_priv *priv, const u8 *data, size_t size)
 			goto out;
 		}
 		left -= n;
+		/* qmi_txn_wait() hands back the decoded length on success */
+		ret = 0;
 	}
 out:
 	kfree(req);
@@ -526,8 +528,8 @@ static int wlfw_send_cal_report(struct icnss_priv *priv)
 		goto out;
 	}
 	ret = qmi_txn_wait(&txn, WLFW_TIMEOUT);
-	if (ret >= 0 && resp->resp.result != QMI_RESULT_SUCCESS_V01)
-		ret = -EINVAL;
+	if (ret >= 0)
+		ret = resp->resp.result == QMI_RESULT_SUCCESS_V01 ? 0 : -EINVAL;
 out:
 	kfree(req);
 	kfree(resp);
-- 
