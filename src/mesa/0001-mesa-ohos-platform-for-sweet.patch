+/* ------------------------------------------------------------------------ */
+/* device selection                                                         */
+/* ------------------------------------------------------------------------ */
+
+static bool
+ohos_want_software(void)
+{
+   /* persist.sys.graphic.mesa.software / environment override for bring-up */
+   if (debug_get_bool_option("OHOS_MESA_SOFTWARE", false))
+      return true;
+   return access("/data/local/tmp/mesa_software", F_OK) == 0;
+}
+
+static EGLBoolean
+ohos_open_kgsl(_EGLDisplay *disp)
+{
+   struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+
+   int fd = loader_open_device("/dev/kgsl-3d0");
+   if (fd < 0) {
+      mesa_logw("ohos: cannot open /dev/kgsl-3d0: %s", strerror(errno));
+      return EGL_FALSE;
+   }
+
+   dri2_dpy->fd_render_gpu = fd;
+   dri2_dpy->driver_name = strdup("kgsl");
+   disp->Options.Kgsl = EGL_TRUE;
+   dri2_dpy->loader_extensions = ohos_image_loader_extensions;
+   dri2_detect_swrast_kopper(disp);
+
+   if (!dri2_create_screen(disp)) {
+      mesa_logw("ohos: freedreno (kgsl) screen creation failed");
+      free(dri2_dpy->driver_name);
+      dri2_dpy->driver_name = NULL;
+      close(fd);
+      dri2_dpy->fd_render_gpu = -1;
+      disp->Options.Kgsl = EGL_FALSE;
+      return EGL_FALSE;
+   }
+
+   mesa_logw("ohos: using Adreno GPU (freedreno on kgsl)");
+   return EGL_TRUE;
+}
+
+static EGLBoolean
+ohos_open_kms_swrast(_EGLDisplay *disp)
+{
+   struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+
+   int fd = loader_open_device("/dev/dri/card0");
+   if (fd < 0)
+      return EGL_FALSE;
+
+   /* never keep the display master: composer_host needs it */
+   drmDropMaster(fd);
+
+   dri2_dpy->fd_render_gpu = fd;
+   dri2_dpy->driver_name = strdup("kms_swrast");
+   dri2_dpy->loader_extensions = ohos_image_loader_extensions;
+   dri2_detect_swrast_kopper(disp);
+
+   if (!dri2_create_screen(disp)) {
+      free(dri2_dpy->driver_name);
+      dri2_dpy->driver_name = NULL;
+      close(fd);
+      dri2_dpy->fd_render_gpu = -1;
+      return EGL_FALSE;
+   }
+
+   mesa_logw("ohos: using software rendering (kms_swrast)");
+   return EGL_TRUE;
+}
+
+EGLBoolean
+dri2_initialize_ohos(_EGLDisplay *disp)
+{
+   struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+   const char *err;
+   bool opened = false;
+
+   if (!ohos_want_software())
+      opened = ohos_open_kgsl(disp);
+   if (!opened)
+      opened = ohos_open_kms_swrast(disp);
+   if (!opened) {
+      err = "DRI2: failed to open a device";
+      goto cleanup;
+   }
+
+   dri2_dpy->fd_display_gpu = dri2_dpy->fd_render_gpu;
+
+   if (!dri2_setup_device(disp, disp->Options.Kgsl ? true : false)) {
+      err = "DRI2: failed to setup EGLDevice";
+      goto cleanup;
+   }
+
+   dri2_setup_screen(disp);
+   dri2_setup_swap_interval(disp, 1);
+
+   disp->Extensions.KHR_image = EGL_TRUE;
+   if (disp->Extensions.ANDROID_native_fence_sync)
+      disp->Extensions.EXT_buffer_age = EGL_TRUE;
+   else
+      disp->Extensions.KHR_partial_update = EGL_FALSE;
+
+   ohos_add_configs_for_visuals(disp);
+
+   dri2_dpy->vtbl = &ohos_display_vtbl;
+
+   return EGL_TRUE;
+
+cleanup:
+   return _eglError(EGL_NOT_INITIALIZED, err);
+}
