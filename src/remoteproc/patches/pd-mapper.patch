+/* sweet / downstream msm: no remoteproc class, the .jsn files live in the
+ * firmware partition (mounted at /vendor/firmware_mnt) and in /vendor/dsp */
+static void pd_scan_dir(struct assoc *json_set, const char *dir)
+{
+	char json_path[PATH_MAX];
+	struct dirent *de;
+	DIR *d = opendir(dir);
+	if (!d)
+		return;
+	while ((de = readdir(d)) != NULL) {
+		size_t len = strlen(de->d_name);
+		if (len > 4 && !strcmp(&de->d_name[len - 4], ".jsn")) {
+			snprintf(json_path, sizeof(json_path), "%s/%s", dir, de->d_name);
+			assoc_set(json_set, json_path, NULL);
+		}
+	}
+	closedir(d);
+}
+
 static int pd_enumerate_jsons(struct assoc *json_set)
+{
+	pd_scan_dir(json_set, "/vendor/firmware_mnt/image");
+	pd_scan_dir(json_set, "/vendor/dsp");
+	pd_scan_dir(json_set, "/vendor/firmware");
+	return 0;
+}
