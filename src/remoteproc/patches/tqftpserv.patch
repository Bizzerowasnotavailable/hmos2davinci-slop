+/* sweet / downstream msm: no remoteproc class; the modem reads its files from
+ * the firmware ("modem") partition mounted at /vendor/firmware_mnt */
+static int translate_readonly(const char *file)
+{
+	static const char *const bases[] = {
+		"/vendor/firmware_mnt/image/", "/vendor/firmware_mnt/", "/vendor/firmware/", "/vendor/dsp/", NULL
+	};
+	char path[PATH_MAX];
+	while (*file == '/')
+		file++;
+	for (int i = 0; bases[i]; i++) {
+		snprintf(path, sizeof(path), "%s%s", bases[i], file);
+		int fd = open(path, O_RDONLY);
+		if (fd >= 0)
+			return fd;
+	}
+	warnx("readonly file not found: %s", file);
+	return -1;
+}
